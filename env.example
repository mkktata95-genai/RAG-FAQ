# ── Azure AI Project ──────────────────────────────────────────
# Get from: Azure AI Foundry → Your Project → Overview
PROJECT_ENDPOINT=https://YOUR_PROJECT_ENDPOINT_HERE

# ── Azure AI Search ───────────────────────────────────────────
# Get from: Azure Portal → Search Service → Overview → Url
AZURE_SEARCH_ENDPOINT=https://rlg-dev-dit-uks-srch-aisplatform.search.windows.net
AZURE_SEARCH_INDEX_NAME=rlg-faq-index

# ── Model Deployments ─────────────────────────────────────────
# Get from: Azure AI Foundry → Your Project → Models + Endpoints
AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024

# ── App Config ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

--------------------------NEW-06/07/26-------------------------------
# ═══════════════════════════════════════════════════════════════
# Aria — Royal London Group AI FAQ Chatbot
# Environment Variables
# Last updated: July 2026 | Mukesh Kund
# ═══════════════════════════════════════════════════════════════

# ── Azure AI Search ──────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://rlg-dev-dit-uks-srch-aisplatform.search.windows.net

# Active index — change this to switch between indexes
# rlg-faq-index       = v1 (original, 22.6% collisions — DO NOT USE)
# rlg-faq-index-v2    = v2 (production-ready, confirmed clean)
# rlg-faq-index-v3    = v3 (target — title_questions, HQA 8/5, not yet built)
AZURE_SEARCH_INDEX_NAME=rlg-faq-index-v2

# Baseline index for A/B comparison with --no-hqa flag
AZURE_SEARCH_BASELINE_INDEX_NAME=rlg-faq-index-v3-baseline

# Semantic ranker config — must match index schema
AZURE_SEARCH_SEMANTIC_CONFIG=rlg-semantic-config

# Minimum reranker score (0-4 scale). Below this = treat as no results
SEMANTIC_MIN_SCORE=0.5

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://rlg-dev-dit-sdc-aisvc-aisplatform.openai.azure.com

# Main model — complex, sensitive, FCA-critical queries
# ⚠️  RETIRES: October 14 2026 on Azure — migrate to gpt-5 before then
AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-4.1

# Fast model — simple product queries, cache canonical rewriting
# ⚠️  RETIRES: October 1 2026 on Azure — migrate to gpt-5-mini before then
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o

# Classification model — intent + query_type in classifier_node.py
# Separate from FAST so changing FAST never silently upgrades classification cost
# Confirmed: 97% accuracy at gpt-4o-mini cost vs gpt-4.1
AZURE_OPENAI_DEPLOYMENT_CLASSIFICATION=gpt-4o-mini

# HQA generation model — chunk_and_index_hqaV3.py only (indexing time)
# Separate from FAST — confirmed 97% agreement with gpt-4.1, 13.4x cheaper
# ($3.79 vs $50.58 for full index run)
AZURE_OPENAI_DEPLOYMENT_HQA=gpt-4o-mini

# Embedding model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIEVED_CHUNKS=5

# ── Azure Content Safety ──────────────────────────────────────
# TODO: Add endpoint URL once provisioned by DevOps (Andy)
CONTENT_SAFETY_ENDPOINT=

# ── Redis / Semantic Cache ────────────────────────────────────
# Development: local Redis or in-memory fallback
# Production: Azure Managed Redis (NOT Azure Cache for Redis — retires 2028)
# Production URL format: rediss://:<password>@<host>.redis.azure.net:6380
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400
CACHE_THRESHOLD=0.90
CACHE_MAX_SIZE=1000