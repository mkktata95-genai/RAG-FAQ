# ═══════════════════════════════════════════════════════════════
# ARIA — Environment Variables
# Royal London Group — RAG Chatbot
# Last updated: July 2026 | Mukesh Kund
# ═══════════════════════════════════════════════════════════════
#
# USAGE:
#   Copy this file to .env and fill in real values.
#   .env is gitignored — never commit real credentials.
#
# TIERS:
#   Local (.env)   — dev/VDI. Fill in values below.
#   Production     — all secrets in Azure Key Vault.
#                    Key Vault secret name shown per entry.
#                    DO NOT duplicate KV secrets in .env on Container Apps.
#
# KEY VAULT NAMING: underscores → hyphens
#   AZURE_SEARCH_ENDPOINT → AZURE-SEARCH-ENDPOINT
# ═══════════════════════════════════════════════════════════════


# ── Azure AI Project ──────────────────────────────────────────
# Get from: Azure AI Foundry → Your Project → Overview
# Key Vault: PROJECT-ENDPOINT
PROJECT_ENDPOINT=https://rlg-dev-dit-sdc-aisvc-aisplatform.services.ai.azure.com/api/projects/rlg-dev-dit-sdc-aisvc-aisplatform-pro


# ── Azure AI Search ───────────────────────────────────────────
# Key Vault: AZURE-SEARCH-ENDPOINT
AZURE_SEARCH_ENDPOINT=https://rlg-dev-dit-uks-srch-aisplatform.search.windows.net

# Main index — full HQA + title_questions
# Key Vault: AZURE-SEARCH-INDEX-NAME
AZURE_SEARCH_INDEX_NAME=rlg-faq-index-v4

# Baseline index — no HQA (A/B comparison)
# Key Vault: AZURE-SEARCH-BASELINE-INDEX-NAME
AZURE_SEARCH_BASELINE_INDEX_NAME=rlg-faq-index-v4-baseline

# Semantic ranker config name (set in Azure Portal)
# Key Vault: AZURE-SEARCH-SEMANTIC-CONFIG
AZURE_SEARCH_SEMANTIC_CONFIG=rlg-semantic-config


# ── Azure OpenAI ──────────────────────────────────────────────
# Key Vault: AZURE-OPENAI-ENDPOINT
AZURE_OPENAI_ENDPOINT=https://rlg-dev-dit-sdc-aisvc-aisplatform.openai.azure.com

# Main generation model — complex/FCA-regulated queries (generator.py)
# RETIRES October 14 2026 on Azure — migrate to gpt-5 before then
# Key Vault: AZURE-OPENAI-DEPLOYMENT-MAIN
AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-4.1

# Fast generation model — simple/conversational queries (generator.py)
# RETIRES October 1 2026 on Azure — migrate to gpt-5-mini before then
# Key Vault: AZURE-OPENAI-DEPLOYMENT-FAST
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o

# Classification model — query type classifier (classifier_node.py)
# Deliberately separate from DEPLOYMENT_FAST so cost never silently escalates
# Key Vault: AZURE-OPENAI-DEPLOYMENT-CLASSIFICATION
AZURE_OPENAI_DEPLOYMENT_CLASSIFICATION=gpt-4o-mini

# HQA generation — indexing time only, 97% agreement with gpt-4.1 at 13.4x lower cost
# Used by chunk_and_index_hqaV4.py and content_freshness.py
# Key Vault: AZURE-OPENAI-DEPLOYMENT-HQA
AZURE_OPENAI_DEPLOYMENT_HQA=gpt-4o-mini

# Embedding model
# Key Vault: AZURE-OPENAI-EMBEDDING-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Embedding dimensions — 1536 for domain-specific accuracy
# Key Vault: AZURE-OPENAI-EMBEDDING-DIMENSIONS
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536


# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIEVED_CHUNKS=5


# ── Retrieval quality thresholds ──────────────────────────────
# Semantic reranker score threshold (0.0–4.0 scale)
# Key Vault: SEMANTIC-MIN-SCORE
SEMANTIC_MIN_SCORE=0.5

# Hybrid search score threshold (0.0–1.0 scale)
# Key Vault: MIN-RELEVANCE-SCORE
MIN_RELEVANCE_SCORE=0.01


# ── Azure Content Safety ──────────────────────────────────────
# TODO: Add endpoint URL once provisioned by Sandeep
# Uses DefaultAzureCredential — no key needed
# Key Vault: CONTENT-SAFETY-ENDPOINT
CONTENT_SAFETY_ENDPOINT=


# ── Playwright (VDI only — DO NOT add to Key Vault) ───────────
# CDP mode: launches system Chrome where ms-playwright chromium
# download is blocked by SSL restrictions on VDI.
# Leave unset in production — CDP auto-skipped on Linux containers.
PLAYWRIGHT_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PLAYWRIGHT_BROWSERS_PATH=C:\Program Files\Google\Chrome\Application
PLAYWRIGHT_CDP_PORT=9222


# ── Redis / Semantic Cache ────────────────────────────────────
# Dev: local Redis  |  Prod: Azure Managed Redis (NOT Azure Cache — retires 2028)
# Prod format: rediss://:<password>@<host>.redis.azure.net:6380
# Key Vault: REDIS-URL
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (86400 = 24 hours)
# Key Vault: CACHE-TTL
CACHE_TTL=86400

# Semantic similarity threshold for cache hit (0.0–1.0)
# Key Vault: CACHE-THRESHOLD
CACHE_THRESHOLD=0.90

# Maximum number of entries in Redis cache
# Key Vault: CACHE-MAX-SIZE
CACHE_MAX_SIZE=1000


# ── Prompt Versioning — Tier 2 (TODO Sprint 3 — Sandeep to provision) ──
# Uncomment when Azure App Config is provisioned
# AZURE_APP_CONFIG_CONNECTION=
# APP_ENV used by prompt_builder_node.py to select config label
# APP_ENV=development


# ── Azure Blob Storage ────────────────────────────────────────
# Key Vault: AZURE-STORAGE-CONNECTION
AZURE_STORAGE_CONNECTION=

# Key Vault: BLOB-CONTAINER-NAME
BLOB_CONTAINER_NAME=scraper-data

# Scraped JSON filename (written by scraper, read by indexer)
# Key Vault: BLOB-SCRAPED-FILENAME
BLOB_SCRAPED_FILENAME=royal_london_faq_latest.json

# Approved URLs Excel (single source of truth)
# Key Vault: BLOB-APPROVED-EXCEL-NAME
BLOB_APPROVED_EXCEL_NAME=approved-urls/Approved_URLs.xlsx

# Content hash state (written after each freshness apply run)
# Key Vault: BLOB-HASH-STATE-NAME
BLOB_HASH_STATE_NAME=freshness/content_hashes.json

# Key Vault: BLOB-REPORT-PREFIX
BLOB_REPORT_PREFIX=freshness/reports/

# Key Vault: BLOB-MANIFEST-PREFIX
BLOB_MANIFEST_PREFIX=freshness/manifests/

# Deleted chunk archives — audit trail + rollback
# Key Vault: BLOB-ARCHIVE-PREFIX
BLOB_ARCHIVE_PREFIX=freshness/archive/


# ── Chunking ──────────────────────────────────────────────────
# WARNING: changing these requires --full reindex.
# Must match in chunk_and_index_hqaV4.py AND content_freshness.py.
# Key Vault: CHUNK-SIZE
CHUNK_SIZE=1600
# Key Vault: CHUNK-OVERLAP
CHUNK_OVERLAP=200


# ── Embedding batch ───────────────────────────────────────────
# 50 safe for S0 tier. Increase to 100 for S1+.
# Key Vault: EMBEDDING-BATCH-SIZE
EMBEDDING_BATCH_SIZE=50


# ── HQA tuning ────────────────────────────────────────────────
# Must match in chunk_and_index_hqaV4.py AND content_freshness.py.
# Key Vault: HQA-QUESTIONS-FIRST-CHUNK
HQA_QUESTIONS_FIRST_CHUNK=8
# Key Vault: HQA-QUESTIONS-OTHER-CHUNKS
HQA_QUESTIONS_OTHER_CHUNKS=5
# Key Vault: TITLE-QUESTIONS-COUNT
TITLE_QUESTIONS_COUNT=3
# Key Vault: TITLE-QUESTIONS-MAX-WORDS
TITLE_QUESTIONS_MAX_WORDS=12


# ── Deduplication ─────────────────────────────────────────────
# Key Vault: MAX-COLLISION-THRESHOLD
MAX_COLLISION_THRESHOLD=3


# ── Versioning ────────────────────────────────────────────────
# Read by content_freshness.py to stamp delta chunks.
# Must match PIPELINE_VERSION constant in chunk_and_index_hqaV4.py.
# Key Vault: PIPELINE-VERSION
PIPELINE_VERSION=1.0.0

# SCRAPER_VERSION, METADATA_VERSION, FRESHNESS_JOB_VERSION
# are hardcoded constants in each script — NOT env vars.
# Bump them directly in source when logic changes.


# ── Scraper flags (Container Apps Job / local override) ───────
# Local Excel path — bypasses Blob download (VDI use)
APPROVED_EXCEL_PATH=scraper/data/Approved_URLs.xlsx

# Run scraper in dry-run mode (validate only, no output written)
DRY_RUN=false


# ── Indexer flags (Container Apps Job / local override) ───────
# Indexer run mode: "full" | "new-only" | "file"
MODE=new-only

# Skip HQA generation — builds baseline index only
NO_HQA=false


# ── Freshness job ─────────────────────────────────────────────
# "report" = scan only, no writes (safe default for local runs)
# "apply"  = execute all index + cache changes (nightly job)
# Key Vault: FRESHNESS-MODE
FRESHNESS_MODE=report