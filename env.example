# ── Azure AI Project ──────────────────────────────────────────
# Get from: Azure AI Foundry → Your Project → Overview
PROJECT_ENDPOINT=https://YOUR_PROJECT_ENDPOINT_HERE

# ── Azure AI Search ───────────────────────────────────────────
# Get from: Azure Portal → Search Service → Overview → Url
AZURE_SEARCH_ENDPOINT=https://rlg-dev-dit-uks-srch-aisplatform.search.windows.net
AZURE_SEARCH_INDEX_NAME=rlg-faq-index

# ── Model Deployments ─────────────────────────────────────────
# Get from: Azure AI Foundry → Your Project → Models + Endpoints
AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024

# ── App Config ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

--------------------------NEW-06/07/26-------------------------------
# ═══════════════════════════════════════════════════════════════
# Aria — Royal London Group AI FAQ Chatbot
# Environment Variables
# Last updated: July 2026 | Mukesh Kund
# ═══════════════════════════════════════════════════════════════

# ── Azure AI Search ──────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://rlg-dev-dit-uks-srch-aisplatform.search.windows.net
AZURE_SEARCH_INDEX_NAME=rlg-faq-index-v2
AZURE_SEARCH_BASELINE_INDEX_NAME=rlg-faq-index-v3-baseline
AZURE_SEARCH_SEMANTIC_CONFIG=rlg-semantic-config

# Retrieval quality thresholds
SEMANTIC_MIN_SCORE=0.5
MIN_RELEVANCE_SCORE=0.3

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://rlg-dev-dit-sdc-aisvc-aisplatform.openai.azure.com

# ⚠️  RETIRES October 14 2026 on Azure — migrate to gpt-5 before then
AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-4.1

# ⚠️  RETIRES October 1 2026 on Azure — migrate to gpt-5-mini before then
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o

# Classification — kept separate from FAST so cost never silently escalates
AZURE_OPENAI_DEPLOYMENT_CLASSIFICATION=gpt-4o-mini

# HQA generation — indexing time only, 97% agreement with gpt-4.1 at 13.4x lower cost
AZURE_OPENAI_DEPLOYMENT_HQA=gpt-4o-mini

# Embeddings
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIEVED_CHUNKS=5

# ── Azure Content Safety ──────────────────────────────────────
# TODO: Add endpoint URL once provisioned by Andy
CONTENT_SAFETY_ENDPOINT=

# ── Redis / Semantic Cache ────────────────────────────────────
# Dev: local Redis   |   Prod: Azure Managed Redis (NOT Azure Cache — retires 2028)
# Prod format: rediss://:<password>@<host>.redis.azure.net:6380
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400
CACHE_THRESHOLD=0.90
CACHE_MAX_SIZE=1000

# ── Prompt Versioning — Tier 2 (TODO Sprint 3 — Andy to provision) ──
# Uncomment when Azure App Config is provisioned
# AZURE_APP_CONFIG_CONNECTION=

# ── Blob Storage — Sprint 3 (TODO — Andy to provision) ───────
# Uncomment when Blob Storage is set up for indexer audit trail
# AZURE_STORAGE_CONNECTION=
# BLOB_CONTAINER_NAME=aria-chunks