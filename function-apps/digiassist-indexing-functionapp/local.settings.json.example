{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "DataStorage": "UseDevelopmentStorage=true",
    "AZURE_SEARCH_ENDPOINT": "https://<search-service>.search.windows.net",
    "AZURE_SEARCH_INDEX_NAME": "<faq index name created by platform>",
    "AZURE_SEARCH_SEMANTIC_CONFIG": "rlg-semantic-config",
    "AZURE_SEARCH_TEMPLATED_INDEX_NAME": "<templated index name created by platform>",
    "AZURE_OPENAI_ENDPOINT": "https://<openai-resource>.openai.azure.com",
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": "text-embedding-3-large",
    "AZURE_OPENAI_EMBEDDING_DIMENSIONS": "1536"
  }
}
